page {
  --c-ink: #13294b;
  --c-primary: #2f6bff;
  --c-bg: #f3f5f8;
  --c-surface: #ffffff;
  --c-text-2: #5a6677;
  background: var(--c-bg);
  color: var(--c-ink);
  font-size: 30rpx;
}

.screen {
  padding: 48rpx 32rpx;
}

.panel {
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--c-surface);
}

.heading {
  font-size: 40rpx;
  font-weight: 700;
}

.description {
  margin-top: 16rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}

.action {
  margin-top: 32rpx;
  min-height: 96rpx;
  border-radius: 20rpx;
  background: var(--c-primary);
  color: var(--c-surface);
  font-size: 34rpx;
  line-height: 96rpx;
  text-align: center;
}

.action::after {
  border: 0;
}

.back {
  margin-top: 24rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: var(--c-ink);
}

.cover {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
