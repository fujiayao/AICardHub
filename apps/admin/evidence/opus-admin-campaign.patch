diff --git a/apps/admin/src/components/campaigns/CampaignForm.vue b/apps/admin/src/components/campaigns/CampaignForm.vue
new file mode 100644
index 0000000..b151710
--- /dev/null
+++ b/apps/admin/src/components/campaigns/CampaignForm.vue
@@ -0,0 +1,230 @@
+<script setup lang="ts">
+import { reactive, useTemplateRef } from "vue";
+import type { FormInstance, FormRules } from "element-plus";
+import type { CampaignInput, CampaignStatus } from "@/api/schema";
+import { statusLabels } from "./campaignMeta";
+
+const props = defineProps<{
+  initial: CampaignInput;
+  busy: boolean;
+  /** Status persisted on the server; ended campaigns cannot be reactivated. */
+  savedStatus: CampaignStatus | null;
+}>();
+const emit = defineEmits<{ save: [value: CampaignInput]; cancel: [] }>();
+
+const MAX_GUIDES = 6;
+function toDate(value: string): Date | null {
+  if (!value) return null;
+  const d = new Date(value);
+  return Number.isNaN(d.getTime()) ? null : d;
+}
+const model = reactive({
+  name: props.initial.name,
+  status: props.initial.status,
+  start: toDate(props.initial.start_at),
+  end: toDate(props.initial.end_at),
+  booth: props.initial.booth,
+  location: props.initial.location,
+  opening_override: props.initial.opening_override,
+  guides: [...props.initial.guide_override],
+});
+const locked = props.savedStatus === "ended";
+const statusOptions = (Object.keys(statusLabels) as CampaignStatus[]).map(
+  (value) => ({ value, label: statusLabels[value] }),
+);
+const form = useTemplateRef<FormInstance>("form");
+type Cb = (e?: Error) => void;
+const rules: FormRules = {
+  name: [
+    { required: true, whitespace: true, message: "请输入活动名称" },
+    { max: 120, message: "活动名称最多 120 字" },
+  ],
+  status: [{ required: true, message: "请选择状态" }],
+  start: [{ required: true, message: "请选择开始时间" }],
+  end: [
+    { required: true, message: "请选择结束时间" },
+    {
+      validator: (_r: unknown, v: Date | null, cb: Cb) =>
+        cb(
+          v && model.start && v.getTime() <= model.start.getTime()
+            ? new Error("结束时间必须晚于开始时间")
+            : undefined,
+        ),
+    },
+  ],
+  booth: [{ max: 80, message: "展位最多 80 字" }],
+  location: [{ max: 255, message: "地点最多 255 字" }],
+  opening_override: [{ max: 2000, message: "开场白最多 2000 字" }],
+  guides: [
+    {
+      validator: (_r: unknown, v: string[], cb: Cb) => {
+        const items = v.map((s) => s.trim()).filter(Boolean);
+        if (items.length > MAX_GUIDES)
+          return cb(new Error("最多 6 条引导问题"));
+        if (items.some((s) => s.length > 255))
+          return cb(new Error("每条引导问题最多 255 字"));
+        cb();
+      },
+    },
+  ],
+};
+function addGuide() {
+  if (model.guides.length < MAX_GUIDES) model.guides.push("");
+}
+function removeGuide(index: number) {
+  model.guides.splice(index, 1);
+}
+async function save() {
+  if (!(await form.value?.validate().catch(() => false))) return;
+  if (!model.start || !model.end) return;
+  emit("save", {
+    name: model.name.trim(),
+    status: locked ? "ended" : model.status,
+    start_at: model.start.toISOString(),
+    end_at: model.end.toISOString(),
+    booth: model.booth.trim(),
+    location: model.location.trim(),
+    opening_override: model.opening_override.trim(),
+    guide_override: model.guides.map((s) => s.trim()).filter(Boolean),
+  });
+}
+</script>
+<template>
+  <el-form
+    ref="form"
+    :model="model"
+    :rules="rules"
+    label-position="top"
+    aria-label="活动表单"
+    @submit.prevent="save"
+  >
+    <el-form-item label="活动名称" prop="name">
+      <el-input v-model="model.name" maxlength="120" show-word-limit />
+    </el-form-item>
+    <el-form-item label="状态" prop="status">
+      <el-radio-group
+        v-model="model.status"
+        :disabled="locked"
+        aria-label="活动状态"
+      >
+        <el-radio-button
+          v-for="opt in statusOptions"
+          :key="opt.value"
+          :value="opt.value"
+          :disabled="locked && opt.value !== 'ended'"
+          >{{ opt.label }}</el-radio-button
+        >
+      </el-radio-group>
+      <p v-if="locked" class="hint">
+        已结束的活动不可重新启用，以保留历史归因。
+      </p>
+      <p v-else class="hint">已启用且处于有效期内的活动才会对访客生效。</p>
+    </el-form-item>
+    <div class="time-grid">
+      <el-form-item label="开始时间" prop="start">
+        <el-date-picker
+          v-model="model.start"
+          type="datetime"
+          placeholder="选择开始时间"
+          aria-label="开始时间"
+          style="width: 100%"
+        />
+      </el-form-item>
+      <el-form-item label="结束时间" prop="end">
+        <el-date-picker
+          v-model="model.end"
+          type="datetime"
+          placeholder="选择结束时间"
+          aria-label="结束时间"
+          style="width: 100%"
+        />
+      </el-form-item>
+    </div>
+    <div class="time-grid">
+      <el-form-item label="展位" prop="booth">
+        <el-input
+          v-model="model.booth"
+          maxlength="80"
+          placeholder="如 A1-203"
+        />
+      </el-form-item>
+      <el-form-item label="地点" prop="location">
+        <el-input v-model="model.location" maxlength="255" />
+      </el-form-item>
+    </div>
+    <el-form-item
+      label="活动开场白（可选，覆盖模板开场白）"
+      prop="opening_override"
+    >
+      <el-input
+        v-model="model.opening_override"
+        type="textarea"
+        :rows="3"
+        maxlength="2000"
+        show-word-limit
+      />
+    </el-form-item>
+    <el-form-item
+      :label="`活动引导问题（可选，最多 ${MAX_GUIDES} 条）`"
+      prop="guides"
+    >
+      <div class="guides">
+        <div v-for="(_, i) in model.guides" :key="i" class="guide-row">
+          <el-input
+            v-model="model.guides[i]"
+            maxlength="255"
+            :aria-label="`引导问题 ${i + 1}`"
+            :placeholder="`引导问题 ${i + 1}`"
+          />
+          <el-button
+            link
+            type="danger"
+            :aria-label="`删除引导问题 ${i + 1}`"
+            @click="removeGuide(i)"
+            >删除</el-button
+          >
+        </div>
+        <el-button
+          :disabled="model.guides.length >= MAX_GUIDES"
+          @click="addGuide"
+          >添加引导问题</el-button
+        >
+      </div>
+    </el-form-item>
+    <div class="actions">
+      <el-button :disabled="busy" @click="emit('cancel')">取消</el-button>
+      <el-button native-type="submit" type="primary" :loading="busy"
+        >保存活动</el-button
+      >
+    </div>
+  </el-form>
+</template>
+<style scoped>
+.time-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 0 var(--ac-space-4);
+}
+.hint {
+  margin: var(--ac-space-1) 0 0;
+  font-size: 12px;
+  color: var(--ac-text-subtle);
+  width: 100%;
+}
+.guides {
+  display: flex;
+  flex-direction: column;
+  gap: var(--ac-space-2);
+  width: 100%;
+}
+.guide-row {
+  display: flex;
+  gap: var(--ac-space-2);
+  align-items: center;
+}
+.actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: var(--ac-space-2);
+}
+</style>
diff --git a/apps/admin/src/components/campaigns/CampaignPanel.vue b/apps/admin/src/components/campaigns/CampaignPanel.vue
new file mode 100644
index 0000000..5b35acb
--- /dev/null
+++ b/apps/admin/src/components/campaigns/CampaignPanel.vue
@@ -0,0 +1,231 @@
+<script setup lang="ts">
+import { computed, onMounted, ref, shallowRef } from "vue";
+import { useRouter } from "vue-router";
+import { ElMessage, ElMessageBox } from "element-plus";
+import { api } from "@/api/adapters";
+import { ApiError } from "@/api/client";
+import type { Campaign, CampaignInput, CampaignStatus } from "@/api/schema";
+import { confirmAction } from "@/composables/useTask";
+import { usePage } from "@/composables/usePage";
+import LoadState from "@/components/LoadState.vue";
+import PageHeader from "@/components/shared/PageHeader.vue";
+import CampaignTable from "./CampaignTable.vue";
+import CampaignForm from "./CampaignForm.vue";
+import CampaignDetail from "./CampaignDetail.vue";
+import { statusFilters } from "./campaignMeta";
+
+const PAGE_SIZE = 20;
+const router = useRouter();
+const status = ref<CampaignStatus | "">("");
+const { busy, error, data, page, load } = usePage<Campaign>((p) =>
+  api.campaigns({
+    page: p,
+    page_size: PAGE_SIZE,
+    ...(status.value ? { status: status.value } : {}),
+  }),
+);
+
+type Mode = "create" | "edit" | "view";
+const mode = ref<Mode | null>(null);
+const current = ref<Campaign | null>(null);
+const draft = ref<CampaignInput | null>(null);
+const saving = shallowRef(false);
+const formKey = shallowRef(0);
+const dialogTitle = computed(() =>
+  mode.value === "create"
+    ? "新建活动"
+    : mode.value === "edit"
+      ? "编辑活动"
+      : "活动详情",
+);
+
+function blank(): CampaignInput {
+  return {
+    name: "",
+    status: "draft",
+    start_at: "",
+    end_at: "",
+    booth: "",
+    location: "",
+    opening_override: "",
+    guide_override: [],
+  };
+}
+function toInput(row: Campaign): CampaignInput {
+  return {
+    name: row.name,
+    status: row.status,
+    start_at: row.start_at,
+    end_at: row.end_at,
+    booth: row.booth,
+    location: row.location,
+    opening_override: row.opening_override,
+    guide_override: [...row.guide_override],
+  };
+}
+function openCreate() {
+  current.value = null;
+  draft.value = blank();
+  mode.value = "create";
+  formKey.value++;
+}
+function openEdit(row: Campaign) {
+  current.value = row;
+  draft.value = toInput(row);
+  mode.value = "edit";
+  formKey.value++;
+}
+function openView(row: Campaign) {
+  current.value = row;
+  draft.value = null;
+  mode.value = "view";
+}
+function closeDialog() {
+  if (saving.value) return;
+  mode.value = null;
+  draft.value = null;
+  current.value = null;
+}
+function onFilter() {
+  void load(1);
+}
+function openReport(row: Campaign) {
+  void router.push({ name: "reports", query: { campaign_id: String(row.id) } });
+}
+
+async function save(body: CampaignInput) {
+  if (saving.value) return;
+  saving.value = true;
+  try {
+    const id = mode.value === "edit" && current.value ? current.value.id : null;
+    await api.saveCampaign(id, body);
+    ElMessage.success(id ? "活动已更新" : "活动已创建");
+    saving.value = false;
+    closeDialog();
+    await load(id ? page.value : 1);
+  } catch {
+    // request() already surfaced the server message via ElMessage
+  } finally {
+    saving.value = false;
+  }
+}
+
+async function remove(row: Campaign) {
+  if (!(await confirmAction(`删除活动“${row.name}”？删除后不可恢复。`))) return;
+  saving.value = true;
+  try {
+    await api.deleteCampaign(row.id);
+    ElMessage.success("活动已删除");
+    saving.value = false;
+    const lastOnPage = data.value.items.length === 1 && page.value > 1;
+    await load(lastOnPage ? page.value - 1 : page.value);
+  } catch (e) {
+    if (e instanceof ApiError && e.status === 409) {
+      await ElMessageBox.alert(
+        e.message || "仅未被使用的草稿活动可删除",
+        "无法删除活动",
+        { type: "warning", confirmButtonText: "知道了" },
+      ).catch(() => undefined);
+    }
+  } finally {
+    saving.value = false;
+  }
+}
+
+onMounted(() => void load(1));
+</script>
+<template>
+  <section class="page">
+    <PageHeader
+      title="活动管理"
+      desc="展会、沙龙等线下活动的获客配置。已启用且处于有效期内的活动才会对访客生效。"
+    >
+      <el-button type="primary" @click="openCreate">新建活动</el-button>
+    </PageHeader>
+    <div class="panel">
+      <div class="toolbar">
+        <el-radio-group
+          v-model="status"
+          aria-label="按状态筛选活动"
+          :disabled="busy"
+          @change="onFilter"
+        >
+          <el-radio-button
+            v-for="f in statusFilters"
+            :key="f.value"
+            :value="f.value"
+            >{{ f.label }}</el-radio-button
+          >
+        </el-radio-group>
+        <el-button :loading="busy" aria-label="刷新活动列表" @click="load()"
+          >刷新</el-button
+        >
+      </div>
+      <LoadState
+        :busy="busy && !data.items.length"
+        :error="error"
+        @retry="load()"
+      />
+      <CampaignTable
+        v-if="!error || data.items.length"
+        v-loading="busy && data.items.length > 0"
+        :rows="data.items"
+        :busy="busy || saving"
+        @view="openView"
+        @edit="openEdit"
+        @remove="remove"
+        @report="openReport"
+      />
+      <div v-if="data.total > PAGE_SIZE" class="pager">
+        <el-pagination
+          layout="total, prev, pager, next"
+          :total="data.total"
+          :page-size="PAGE_SIZE"
+          :current-page="page"
+          :disabled="busy"
+          size="small"
+          background
+          @current-change="(p: number) => load(p)"
+        />
+      </div>
+    </div>
+    <el-dialog
+      :model-value="mode !== null"
+      :title="dialogTitle"
+      width="min(720px, 100vw)"
+      :close-on-click-modal="false"
+      @update:model-value="(v: boolean) => !v && closeDialog()"
+    >
+      <CampaignForm
+        v-if="mode !== 'view' && draft"
+        :key="formKey"
+        :initial="draft"
+        :busy="saving"
+        :saved-status="mode === 'edit' && current ? current.status : null"
+        @save="save"
+        @cancel="closeDialog"
+      />
+      <CampaignDetail
+        v-else-if="mode === 'view' && current"
+        :campaign="current"
+        @edit="current && openEdit(current)"
+        @report="current && openReport(current)"
+      />
+    </el-dialog>
+  </section>
+</template>
+<style scoped>
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: var(--ac-space-2);
+  margin-bottom: var(--ac-space-3);
+}
+.pager {
+  display: flex;
+  justify-content: flex-end;
+  margin-top: var(--ac-space-3);
+  overflow-x: auto;
+}
+</style>
diff --git a/apps/admin/src/components/campaigns/CampaignReportPanel.vue b/apps/admin/src/components/campaigns/CampaignReportPanel.vue
new file mode 100644
index 0000000..5596c36
--- /dev/null
+++ b/apps/admin/src/components/campaigns/CampaignReportPanel.vue
@@ -0,0 +1,287 @@
+<script setup lang="ts">
+import { computed, onMounted, ref, shallowRef, watch } from "vue";
+import { useRoute, useRouter } from "vue-router";
+import { api } from "@/api/adapters";
+import type { Campaign, CampaignReport } from "@/api/schema";
+import { useTask } from "@/composables/useTask";
+import LoadState from "@/components/LoadState.vue";
+import PageHeader from "@/components/shared/PageHeader.vue";
+import { formatTime, sourceLabels, statusLabels } from "./campaignMeta";
+
+const route = useRoute();
+const router = useRouter();
+const list = useTask();
+const campaigns = ref<Campaign[]>([]);
+const selected = shallowRef<number | null>(null);
+const report = ref<CampaignReport | null>(null);
+let requestSeq = 0;
+
+const current = computed(
+  () => campaigns.value.find((c) => c.id === selected.value) ?? null,
+);
+const kpis = computed(() => {
+  const r = report.value;
+  if (!r) return [];
+  // Totals come straight from the server; visitors are de-duplicated across
+  // sources, so they must never be recomputed from source_breakdown.
+  return [
+    { key: "visits", label: "访问次数", value: r.visits },
+    { key: "visitors", label: "访客数", value: r.visitors },
+    { key: "chats", label: "有效对话", value: r.chats },
+    { key: "leads", label: "线索", value: r.leads },
+  ];
+});
+
+function queryId(): number | null {
+  const raw = route.query.campaign_id;
+  const value = Array.isArray(raw) ? raw[0] : raw;
+  const id = Number(value);
+  return value && Number.isInteger(id) && id > 0 ? id : null;
+}
+
+async function loadCampaigns() {
+  await list.run(async () => {
+    const page = await api.campaigns({ page: 1, page_size: 100 });
+    campaigns.value = page.items;
+  });
+  const wanted = queryId();
+  if (wanted !== null) selected.value = wanted;
+  else if (!selected.value && campaigns.value.length)
+    selected.value = campaigns.value[0].id;
+}
+
+// Own loader (not useTask) so switching campaigns mid-request is never dropped;
+// stale responses are discarded by sequence number.
+const rep = { busy: shallowRef(false), error: shallowRef("") };
+async function loadReport() {
+  const id = selected.value;
+  const seq = ++requestSeq;
+  report.value = null;
+  rep.error.value = "";
+  if (id === null) {
+    rep.busy.value = false;
+    return;
+  }
+  rep.busy.value = true;
+  try {
+    const data = await api.campaignReport(id);
+    if (seq === requestSeq) report.value = data;
+  } catch (e) {
+    if (seq === requestSeq)
+      rep.error.value = e instanceof Error ? e.message : "报表加载失败，请重试";
+  } finally {
+    if (seq === requestSeq) rep.busy.value = false;
+  }
+}
+type SourceRow = CampaignReport["source_breakdown"][number];
+const sourceName = (row: SourceRow) => sourceLabels[row.source] ?? row.source;
+
+watch(selected, (id) => {
+  if (id !== queryId())
+    void router.replace({
+      query: {
+        ...route.query,
+        campaign_id: id === null ? undefined : String(id),
+      },
+    });
+  void loadReport();
+});
+watch(
+  () => route.query.campaign_id,
+  () => {
+    const id = queryId();
+    if (id !== null && id !== selected.value) selected.value = id;
+  },
+);
+
+onMounted(loadCampaigns);
+</script>
+<template>
+  <section class="page">
+    <PageHeader
+      title="活动报表"
