{
  "name": "aicardhub-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src scripts vite.config.ts && prettier --check src scripts *.json *.ts *.html README.md TEMPLATE_SOURCE.md",
    "format": "prettier --write src scripts *.json *.ts *.html README.md TEMPLATE_SOURCE.md",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "gen:api": "node scripts/generate-api.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.22",
    "vue-router": "4.6.3",
    "pinia": "3.0.3",
    "element-plus": "2.11.5",
    "@pureadmin/table": "3.3.0",
    "md-editor-v3": "^5.8.4",
    "dompurify": "^3.3.0"
  },
  "devDependencies": {
    "vite": "7.1.12",
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.2",
    "@types/node": "^24.10.0",
    "eslint": "9.38.0",
    "@eslint/js": "9.38.0",
    "typescript-eslint": "8.46.2",
    "eslint-plugin-vue": "10.5.1",
    "vue-eslint-parser": "10.2.0",
    "prettier": "3.6.2",
    "openapi-typescript": "^7.10.1"
  }
}
