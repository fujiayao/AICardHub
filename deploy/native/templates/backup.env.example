# AICardHub private backup configuration (non-secret).
# Install as /etc/aicardhub/backup.env root:root mode 0600.
# MySQL credentials belong only in MYSQL_DEFAULTS_FILE, never here.

DEPLOY_ROOT=/opt/aicardhub
BACKUP_ROOT=/var/backups/aicardhub
BACKUP_RETENTION_DAYS=14
BACKUP_LOG=/opt/aicardhub/logs/backup.log
LOG_DIR=/opt/aicardhub/logs
LOG_GROUP=adm
MYSQL_DEFAULTS_FILE=/etc/aicardhub/mysql-backup.cnf
MYSQL_DATABASE=aicardhub
MYSQL_DUMP_BIN=mysqldump
API_HOST=127.0.0.1
API_PORT=18000
SERVICE_USER=aicardhub
SERVICE_GROUP=aicardhub
SHARED_DIR=/opt/aicardhub/shared
UPLOAD_DIR=/opt/aicardhub/shared/uploads
KB_DIR=/opt/aicardhub/shared/kb
ENV_FILE=/opt/aicardhub/shared/env
RELEASES_DIR=/opt/aicardhub/releases
CURRENT_LINK=/opt/aicardhub/current
API_UNIT=aicardhub-api.service
SCHEDULER_UNIT=aicardhub-scheduler.service
DEPLOY_LOCK=/run/aicardhub-maintenance.lock
MAINTENANCE_LOCK=/run/aicardhub-maintenance.lock
