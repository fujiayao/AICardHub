# AICardHub application environment.
# Install as /opt/aicardhub/shared/env with root:root mode 0600.
# Supply every secret out-of-band. Never commit a populated copy.
# systemd reads this file as EnvironmentFile; it is never sourced by a shell.

APP_ENV=prod
DATABASE_URL=
JWT_SECRET=
TEST_DATABASE_URL=
KB_ROOT=/opt/aicardhub/shared/kb
UPLOAD_ROOT=/opt/aicardhub/shared/uploads
PUBLIC_BASE_URL=https://haiwex.com/aicardhub
LLM_MODE=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_API_MODE=chat_completions
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_MODE=chat_completions
LLM_TERTIARY_ENABLED=false
LLM_TERTIARY_BASE_URL=
LLM_TERTIARY_MODEL=
LLM_TERTIARY_API_KEY=
LLM_TERTIARY_API_MODE=chat_completions
