# AICardHub native EL9 deployment configuration (non-secret).
# Copy to an operator-controlled location, replace placeholders, then render.
# Values must not contain whitespace. This file is NOT the product environment.

DEPLOY_ROOT=/opt/aicardhub
SERVICE_NAME=aicardhub
SERVICE_USER=aicardhub
SERVICE_GROUP=aicardhub
RELEASES_DIR=/opt/aicardhub/releases
SHARED_DIR=/opt/aicardhub/shared
UPLOAD_DIR=/opt/aicardhub/shared/uploads
KB_DIR=/opt/aicardhub/shared/kb
LOG_DIR=/opt/aicardhub/logs
OPS_DIR=/opt/aicardhub/ops
CURRENT_LINK=/opt/aicardhub/current
ENV_FILE=/opt/aicardhub/shared/env
MIGRATION_GATE_FILE=/opt/aicardhub/shared/migration-gate.ok
DEPLOY_LOCK=/run/aicardhub-maintenance.lock
MAINTENANCE_LOCK=/run/aicardhub-maintenance.lock
PYTHON_RUNTIME=/usr/bin/python3.12
VENV_DIR=venv
API_HOST=127.0.0.1
API_PORT=18000
API_WORKERS=1
API_UNIT=aicardhub-api.service
SCHEDULER_UNIT=aicardhub-scheduler.service
BACKUP_UNIT=aicardhub-backup.service
BACKUP_TIMER=aicardhub-backup.timer
API_MEMORY_HIGH=800M
API_MEMORY_MAX=1200M
SCHEDULER_MEMORY_HIGH=256M
SCHEDULER_MEMORY_MAX=512M
SITE_NAME=aicardhub
SITE_DOMAIN=haiwex.com
NGINX_INCLUDE_FILE=/opt/aicardhub/ops/nginx/aicardhub.locations.conf
STAGE_CONF_FILE=/opt/aicardhub/ops/nginx/aicardhub.stage.conf
STAGE_LISTEN=127.0.0.1:18080
STAGE_SERVER_NAME=localhost
NGINX_USER=nginx
NGINX_GROUP=nginx
NGINX_PID_FILE=/run/nginx.pid
NGINX_LOG_DIR=/var/log/nginx
NGINX_ACCESS_LOG=/var/log/nginx/aicardhub_access.log
NGINX_ERROR_LOG=/var/log/nginx/aicardhub_error.log
NGINX_LOG_GROUP=adm
LOGROTATE_CONF_DIR=/etc/logrotate.d
SYSTEMD_UNIT_DIR=/etc/systemd/system
BACKUP_ROOT=/var/backups/aicardhub
BACKUP_RETENTION_DAYS=14
BACKUP_LOG=/opt/aicardhub/logs/backup.log
BACKUP_ENV_FILE=/etc/aicardhub/backup.env
MYSQL_DEFAULTS_FILE=/etc/aicardhub/mysql-backup.cnf
MYSQL_DATABASE=aicardhub
MYSQL_DUMP_BIN=mysqldump
